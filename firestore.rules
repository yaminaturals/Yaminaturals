rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to verify admin claims / admin email
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@yaminaturals\\.com$') ||
        request.auth.token.email == 'admin@yaminaturals.com'
      );
    }
    
    // Helper to validate email format
    function isValidEmail(email) {
      return email is string && email.size() > 5 && email.size() < 254 && email.matches('^[^@]+@[^@]+\\.[^@]+$');
    }
    
    // Helper to validate non-empty string
    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }
    
    // Products: Public read, strictly Admin write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Categories: Public read, Admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Applications: Public read, Admin write
    match /applications/{applicationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Resources / Whitepapers: Public read, Admin write
    match /resources/{resourceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // FAQs: Public read, Admin write
    match /faqs/{faqId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Settings: Public read, Admin write
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Quote Requests (RFQs):
    // Public may create valid quote inquiries with input validation
    // ONLY Admin can read, update, or delete quotes
    match /quotes/{quoteId} {
      allow create: if isNonEmptyString(request.resource.data.name, 100) &&
                       isValidEmail(request.resource.data.email) &&
                       isNonEmptyString(request.resource.data.product, 150) &&
                       request.resource.data.keys().hasAll(['name', 'email', 'product', 'createdAt']);
      allow read, update, delete: if isAdmin();
    }
    
    // Contact Inquiries:
    // Public may create valid contact messages
    // ONLY Admin can read, update, or delete contacts
    match /contacts/{contactId} {
      allow create: if isNonEmptyString(request.resource.data.name, 100) &&
                       isValidEmail(request.resource.data.email) &&
                       isNonEmptyString(request.resource.data.message, 5000) &&
                       request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt']);
      allow read, update, delete: if isAdmin();
    }
    
    // Document Requests (COA/TDS):
    // Public may submit document requests with validation
    // ONLY Admin can read, update, or delete document requests
    match /documents/{docId} {
      allow create: if isNonEmptyString(request.resource.data.name, 100) &&
                       isValidEmail(request.resource.data.email) &&
                       isNonEmptyString(request.resource.data.productName, 150) &&
                       request.resource.data.keys().hasAll(['name', 'email', 'productName', 'createdAt']);
      allow read, update, delete: if isAdmin();
    }
    
    // Catch-all: Deny any other path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
