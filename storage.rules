rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@yaminaturals\\.com$') ||
        request.auth.token.email == 'admin@yaminaturals.com'
      );
    }
    
    // Public product images: Public read, Admin upload with type & size validation
    match /products/{allImages=**} {
      allow read: if true;
      allow write: if isAdmin() &&
                      request.resource.size < 10 * 1024 * 1024 &&
                      (request.resource.contentType.matches('image/(jpeg|png|webp|svg\\+xml)') ||
                       request.resource.contentType == 'application/pdf');
    }
    
    // Public technical documents (COA/TDS/MSDS): Public read, Admin write
    match /documents/{allDocs=**} {
      allow read: if true;
      allow write: if isAdmin() &&
                      request.resource.size < 20 * 1024 * 1024 &&
                      request.resource.contentType == 'application/pdf';
    }
    
    // Catch-all: Deny all unauthenticated writes
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
